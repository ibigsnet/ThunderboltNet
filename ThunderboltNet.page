<?php
/**
 * Thunderbolt-specific overview (controller, modules, fabric, PCI/IOMMU).
 * Per-link addressing lives on Thunderbolt tbn0 / tbn1 tabs.
 * Absolute paths only — Unraid .page eval breaks __DIR__.
 */
require_once '/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php';

$plugin = 'ThunderboltNet';
$cfg = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : [];
if (!is_array($cfg)) {
  $cfg = [];
}
$cfg = array_merge(tbn_load_cfg(), $cfg);

tbn_sync_iface_pages();

$status = tbn_status();
$mods = $status['modules'];
$devices = $status['devices'];
$netdevs = $status['netdevs'];
$include = $status['include_interfaces'];
$has_hw = !empty($status['has_hardware']);
$diag = tbn_diagnostics_text();
$pci = tbn_list_pci_iommu();
$ver = tbn_plugin_version();
$ifaces = tbn_list_tb_iface_names();

$mod_tb = !empty($mods['thunderbolt']) ? 'loaded' : 'not loaded';
$mod_net = !empty($mods['thunderbolt_net']) ? 'loaded' : 'not loaded';
$peer_count = 0;
foreach ($devices as $d) {
  if (preg_match('/^\d+-\d+$/', $d['id']) && $d['id'] !== '0-0' && ($d['device_name'] !== '' || $d['rx_speed'] !== '')) {
    $peer_count++;
  }
}
$issues_url = 'https://github.com/ibigsnet/ThunderboltNet/issues';
?>
<link rel="stylesheet" href="/plugins/ThunderboltNet/thunderboltnet.css?v=<?= htmlspecialchars($ver) ?>">

<div class="tbn-wrap">

<?php if (!$has_hw): ?>
  <div class="tbn-notice" role="status">
    <h4>No Thunderbolt hardware detected</h4>
    <p>
      No Thunderbolt / USB4 host controller is visible to Linux.
      This plugin is not required on this system unless you add compatible hardware.
    </p>
    <p>
      If that seems wrong, copy the diagnostics below and open an issue:
      <a href="<?= htmlspecialchars($issues_url) ?>" target="_blank" rel="noopener"><?= htmlspecialchars($issues_url) ?></a>
    </p>
    <label class="tbn-diag-label" for="tbn-diagnostics">Diagnostics</label>
    <textarea id="tbn-diagnostics" class="tbn-diag" readonly rows="14" spellcheck="false"><?= htmlspecialchars($diag) ?></textarea>
    <p class="tbn-actions">
      <input type="button" value="Copy diagnostics" onclick="tbnCopyDiagnostics()">
      <input type="button" value="Refresh" onclick="location.reload()">
      <input type="button" value="Done" onclick="done()">
    </p>
  </div>

<?php else: ?>

<?php
  $links = $status['links'] ?? tbn_link_summaries();
  $local_ctrl = $status['local_controller'] ?? tbn_sysfs_str('/sys/bus/thunderbolt/devices/0-0/device_name');
  $local_mfg = $status['local_manufacturer'] ?? tbn_sysfs_str('/sys/bus/thunderbolt/devices/0-0/vendor_name');
?>
  <div class="tbn-section">
    <h3>This host</h3>
    <p class="tbn-note">
      OS hostname is from Unraid. Controller product and manufacturer come from the local Thunderbolt host
      router (sysfs <code>0-0</code>) — usually the motherboard or add-in card name and OEM.
    </p>
    <table class="tbn-table tbn-summary">
      <tr><td>OS hostname</td><td><code><?= htmlspecialchars($status['hostname']) ?></code></td></tr>
      <tr><td>Controller product</td><td><?= htmlspecialchars($local_ctrl !== '' ? $local_ctrl : '—') ?></td></tr>
      <tr><td>Manufacturer</td><td><?= htmlspecialchars($local_mfg !== '' ? $local_mfg : '—') ?></td></tr>
      <tr><td>Domain security</td><td><code><?= htmlspecialchars($status['security'] ?: '(none/unknown)') ?></code></td></tr>
      <tr><td>Kernel modules</td>
        <td><code>thunderbolt</code> <?= htmlspecialchars($mod_tb) ?> ·
            <code>thunderbolt_net</code> <?= htmlspecialchars($mod_net) ?></td></tr>
      <tr><td>Listening includes</td>
        <td><code><?= htmlspecialchars(implode(' ', $include) ?: '(none)') ?></code>
          <span class="tbn-muted"> — interfaces Unraid services may bind on (network-extra)</span></td></tr>
      <tr><td>Interface tabs</td>
        <td>
<?php if (!$ifaces): ?>
          <span class="tbn-muted">No thunderbolt* netdevs yet</span>
<?php else: ?>
<?php foreach ($ifaces as $if): $lb = tbn_label_for_iface($if); ?>
          <a href="/Settings/NetworkSettings" onclick="return tbnGotoNetTab('<?= htmlspecialchars($lb, ENT_QUOTES) ?>', event)"><code><?= htmlspecialchars($lb) ?></code></a>
<?php endforeach; ?>
<?php endif; ?>
        </td>
      </tr>
    </table>
  </div>

  <div class="tbn-section">
    <h3>Links</h3>
    <p class="tbn-note">
      Each row compares <strong>this Unraid host</strong> with the <strong>far-side peer</strong> on that cable.
      Thunderbolt advertises peer <em>name</em> and <em>stack</em> separately from OEM branding:
      local manufacturer is often the board vendor (e.g. ASUS); remote “stack” on Linux peers is often
      <code>Linux</code> (the TB software identity), while peer name is usually that machine’s hostname.
      Link speed/lanes are the trained fabric rate. IP and bond settings are on each <strong>tbnN</strong> tab.
    </p>
<?php if (!$links): ?>
    <p class="tbn-muted">No active Thunderbolt network interfaces.</p>
<?php else: ?>
<?php foreach ($links as $L):
  $loc = $L['local'];
  $rem = $L['remote'];
  $lldp = $L['lldp'];
  $mem = !empty($loc['membership']) ? implode(' ', $loc['membership']) : (!empty($loc['master']) ? $loc['master'] : 'none');
?>
    <table class="tbn-table tbn-wide tbn-link-card">
      <thead>
        <tr>
          <th style="width:11em"></th>
          <th>Local (this host)</th>
          <th>Remote (peer)</th>
        </tr>
        <tr>
          <th colspan="3" class="tbn-link-title">
            <a href="/Settings/NetworkSettings" onclick="return tbnGotoNetTab('<?= htmlspecialchars($L['label'], ENT_QUOTES) ?>', event)"><?= htmlspecialchars($L['label']) ?></a>
            <span class="tbn-muted"> · kernel <code><?= htmlspecialchars($L['iface']) ?></code>
              · settings on the tbn tab</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Name</td>
          <td><code><?= htmlspecialchars($loc['os_hostname'] !== '' ? $loc['os_hostname'] : '—') ?></code>
            <span class="tbn-muted"> (OS hostname)</span></td>
          <td><code><?= htmlspecialchars($rem['peer_name'] !== '' ? $rem['peer_name'] : '—') ?></code>
            <span class="tbn-muted"> (peer name from fabric)</span></td>
        </tr>
        <tr>
          <td>Product / identity</td>
          <td><?= htmlspecialchars($loc['product'] !== '' ? $loc['product'] : '—') ?>
            <span class="tbn-muted"> (TB controller product)</span></td>
          <td><?= htmlspecialchars($rem['peer_name'] !== '' ? $rem['peer_name'] : '—') ?>
            <span class="tbn-muted"> (same as peer name when only one string is advertised)</span></td>
        </tr>
        <tr>
          <td>Manufacturer / stack</td>
          <td><?= htmlspecialchars($loc['manufacturer'] !== '' ? $loc['manufacturer'] : '—') ?>
            <span class="tbn-muted"> (OEM / board vendor)</span></td>
          <td><?= htmlspecialchars($rem['stack'] !== '' ? $rem['stack'] : '—') ?>
            <span class="tbn-muted"> (TB stack identity; often “Linux” on Linux peers)</span></td>
        </tr>
        <tr>
          <td>Link RX / TX</td>
          <td class="tbn-muted">— (rate is end-to-end on the peer hop)</td>
          <td>
            <strong><?= htmlspecialchars($rem['rx_speed'] !== '' ? $rem['rx_speed'] : '—') ?></strong>
            /
            <strong><?= htmlspecialchars($rem['tx_speed'] !== '' ? $rem['tx_speed'] : '—') ?></strong>
          </td>
        </tr>
        <tr>
          <td>Lanes RX / TX</td>
          <td class="tbn-muted">—</td>
          <td><?= htmlspecialchars(($rem['rx_lanes'] !== '' ? $rem['rx_lanes'] : '—') . ' / ' . ($rem['tx_lanes'] !== '' ? $rem['tx_lanes'] : '—')) ?></td>
        </tr>
        <tr>
          <td>Interface state</td>
          <td><?= htmlspecialchars($loc['operstate'] ?: '—') ?>
            · carrier <?= htmlspecialchars($loc['carrier'] === '' ? 'n/a' : $loc['carrier']) ?>
            · MTU <?= htmlspecialchars($loc['mtu'] !== '' ? $loc['mtu'] : '—') ?></td>
          <td class="tbn-muted">See peer name / speeds above</td>
        </tr>
        <tr>
          <td>MAC</td>
          <td><code><?= htmlspecialchars(strtoupper($loc['mac'] ?: '—')) ?></code></td>
          <td class="tbn-muted">—</td>
        </tr>
        <tr>
          <td>IPv4 (live)</td>
          <td><code><?= htmlspecialchars($loc['addrs'] ? implode(', ', $loc['addrs']) : '—') ?></code></td>
          <td class="tbn-muted">Not visible from this host without probing</td>
        </tr>
        <tr>
          <td>Listening include</td>
          <td><?= !empty($loc['listening']) ? 'yes' : 'no' ?></td>
          <td class="tbn-muted">—</td>
        </tr>
        <tr>
          <td>Bond / bridge</td>
          <td><code><?= htmlspecialchars($mem) ?></code></td>
          <td class="tbn-muted">—</td>
        </tr>
        <tr>
          <td>Fabric UUID / service</td>
          <td class="tbn-muted">local controller UUID on devices table</td>
          <td>
<?php if ($rem['unique_id'] !== ''): ?>
            <code><?= htmlspecialchars($rem['unique_id']) ?></code>
            <?php if ($rem['service'] !== ''): ?><br>service <code><?= htmlspecialchars($rem['service']) ?></code><?php endif; ?>
<?php else: ?>
            <span class="tbn-muted">No peer fabric entry (link down or not trained)</span>
<?php endif; ?>
          </td>
        </tr>
        <tr>
          <td>LLDP</td>
          <td colspan="2" class="tbn-muted"><?= htmlspecialchars($lldp['summary'] !== '' ? $lldp['summary'] : 'n/a') ?>
            — optional; TB fabric data above is primary</td>
        </tr>
      </tbody>
    </table>
<?php endforeach; ?>
<?php endif; ?>
  </div>

  <div class="tbn-section">
    <h3>PCI / IOMMU / VFIO</h3>
    <p class="tbn-note">
      Shows how the Thunderbolt controller is attached to the CPU/PCIe fabric.
      If the NHI (host interface) is bound to <code>vfio-pci</code>, Unraid cannot use host Thunderbolt networking
      until that device is returned to the host driver. Warnings appear above the details button when relevant.
    </p>
<?php
  $tbn_pci_uid = 'overview';
  require '/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-pci-panel.php';
?>
  </div>

  <div class="tbn-section">
    <h3>Fabric devices</h3>
    <p class="tbn-note">
      Raw Thunderbolt topology. <strong>Name</strong> is the advertised device name.
      <strong>Manufacturer / stack</strong> is the TB <code>vendor_name</code> field: for the local host router
      this is usually the OEM (e.g. ASUS); for a Linux peer it is often the software stack (<code>Linux</code>), not the chassis brand.
    </p>
<?php if (!$devices): ?>
    <p class="tbn-muted">No entries under <code>/sys/bus/thunderbolt/devices</code>.</p>
<?php else: ?>
    <table class="tbn-table tbn-wide">
      <thead>
        <tr>
          <th>ID</th>
          <th>Role</th>
          <th>Name</th>
          <th>Manufacturer / stack</th>
          <th>RX / TX</th>
          <th>Lanes</th>
          <th>Netdevs</th>
        </tr>
      </thead>
      <tbody>
<?php foreach ($devices as $d):
  $id = $d['id'];
  $role = 'node';
  if ($id === 'domain0') {
    $role = 'domain';
  } elseif ($id === '0-0') {
    $role = 'local controller';
  } elseif (preg_match('/^\d+-\d+$/', $id) && $id !== '0-0') {
    $role = 'peer';
  } elseif (preg_match('/\.\d+$/', $id)) {
    $role = 'service';
  }
?>
        <tr>
          <td><code><?= htmlspecialchars($id) ?></code></td>
          <td><?= htmlspecialchars($role) ?></td>
          <td><?= htmlspecialchars($d['device_name'] ?: '—') ?></td>
          <td><?= htmlspecialchars($d['vendor_name'] ?: '—') ?></td>
          <td><?= htmlspecialchars(trim(($d['rx_speed'] ?: '—') . ' / ' . ($d['tx_speed'] ?: '—'))) ?></td>
          <td><?= htmlspecialchars(trim(($d['rx_lanes'] ?: '—') . ' / ' . ($d['tx_lanes'] ?: '—'))) ?></td>
          <td><code><?= htmlspecialchars($d['netdevs'] ? implode(', ', $d['netdevs']) : '—') ?></code></td>
        </tr>
<?php endforeach; ?>
      </tbody>
    </table>
<?php endif; ?>
  </div>

  <div class="tbn-section tbn-section-drivers">
    <h3>Driver options</h3>
    <p class="tbn-note">
      These options only affect how Unraid loads the Thunderbolt kernel drivers when you click Apply here.
      They do not change Ethernet, Docker, or VMs. Interface IP settings are on each <strong>tbnN</strong> tab.
    </p>
    <form method="POST" action="/update.php" target="progressFrame">
      <input type="hidden" name="#file" value="ThunderboltNet/ThunderboltNet.cfg">
      <input type="hidden" name="#include" value="/plugins/ThunderboltNet/include/tbn-update.php">
      <input type="hidden" name="tbn_defaults" value="">
      <input type="hidden" name="include_listening" value="<?= htmlspecialchars($cfg['include_listening'] ?? 'no') ?>">
      <input type="hidden" name="manage_ip" value="<?= htmlspecialchars($cfg['manage_ip'] ?? 'no') ?>">
      <input type="hidden" name="ip_addr" value="<?= htmlspecialchars($cfg['ip_addr'] ?? '10.255.1.2') ?>">
      <input type="hidden" name="ip_cidr" value="<?= htmlspecialchars($cfg['ip_cidr'] ?? '24') ?>">
      <input type="hidden" name="ip_gateway" value="<?= htmlspecialchars($cfg['ip_gateway'] ?? '') ?>">
      <input type="hidden" name="never_default" value="<?= htmlspecialchars($cfg['never_default'] ?? 'yes') ?>">
      <input type="hidden" name="iface_primary" value="<?= htmlspecialchars($cfg['iface_primary'] ?? 'thunderbolt0') ?>">
      <input type="hidden" name="iface_secondary" value="<?= htmlspecialchars($cfg['iface_secondary'] ?? 'thunderbolt1') ?>">
      <input type="hidden" name="bond_enable" value="<?= htmlspecialchars($cfg['bond_enable'] ?? 'no') ?>">
      <input type="hidden" name="bond_name" value="<?= htmlspecialchars($cfg['bond_name'] ?? 'bond-tb') ?>">
      <input type="hidden" name="bond_mode" value="<?= htmlspecialchars($cfg['bond_mode'] ?? 'balance-rr') ?>">
      <input type="hidden" name="ignore_warnings" value="<?= htmlspecialchars($cfg['ignore_warnings'] ?? '') ?>">

      <dl>
        <dt>Load modules on Apply:</dt>
        <dd>
          <select name="load_modules">
            <?= mk_option($cfg['load_modules'] ?? 'yes', 'yes', 'Yes') ?>
            <?= mk_option($cfg['load_modules'] ?? 'yes', 'no', 'No') ?>
          </select>
          <span class="tbn-hint">
            When Yes, Apply runs <code>modprobe thunderbolt</code> and <code>modprobe thunderbolt_net</code>
            so the controller and host-to-host network function can appear.
            Does <strong>not</strong> unbind the NHI from the host driver (that can wedge some controllers).
            Choose No only if you load these modules yourself (e.g. in <code>go</code>).
          </span>
        </dd>

        <dt>E2E flow control:</dt>
        <dd>
          <select name="e2e_flow_control">
            <?= mk_option($cfg['e2e_flow_control'] ?? 'no', 'no', 'No (e2e=0)') ?>
            <?= mk_option($cfg['e2e_flow_control'] ?? 'no', 'yes', 'Yes (driver default)') ?>
          </select>
          <span class="tbn-hint">
            Sets the <code>thunderbolt_net</code> module option <code>e2e</code> (end-to-end flow control).
            Many cross-host (Unraid ↔ Linux desktop) links behave more reliably with <strong>No (e2e=0)</strong>.
            Use Yes only if you need the driver default for a specific peer.
          </span>
        </dd>
      </dl>

      <p class="tbn-actions">
        <input type="submit" name="#apply" value="Apply">
        <input type="button" value="Done" onclick="done()">
      </p>
    </form>
  </div>

  <blockquote class="inline_help">
    <p>Use Thunderbolt 4 / USB4 cables for host links. Do not unbind the Thunderbolt NHI from the host driver.</p>
  </blockquote>

<?php endif; ?>

</div>
<script src="/plugins/ThunderboltNet/thunderboltnet.js?v=<?= htmlspecialchars($ver) ?>"></script>
