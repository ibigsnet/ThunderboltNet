Menu="NetworkServices"
Title="Thunderbolt Net"
Icon="sitemap"
---
<?php
$plugin = 'ThunderboltNet';
$cfg = parse_plugin_cfg($plugin);
require_once __DIR__ . '/include/tbn-lib.php';

$status = tbn_status();
$mods = $status['modules'];
$devices = $status['devices'];
$netdevs = $status['netdevs'];
$include = $status['include_interfaces'];
$ver = '2026.07.29aa';
foreach (['/tmp/plugins/thunderboltnet.plg', '/boot/config/plugins/thunderboltnet.plg'] as $plg) {
  if (is_file($plg)) {
    if (preg_match('/ENTITY version "([^"]+)"/', file_get_contents($plg), $m)) {
      $ver = $m[1];
      break;
    }
  }
}
?>
<link rel="stylesheet" href="/plugins/ThunderboltNet/thunderboltnet.css?v=<?= htmlspecialchars($ver) ?>">

<div class="tbn-wrap">
  <p class="tbn-lead">
    Discover Thunderbolt/USB4 host links and netdevs, optionally include them in Unraid
    <strong>listening interfaces</strong>, and apply a simple static IP for bulk transfers.
    Does <strong>not</strong> replace Network Settings for eth0/br0 — host TB only.
  </p>

  <blockquote class="inline_help">
    <p><strong>Do not</strong> unbind the Thunderbolt NHI (Maple Ridge) from the host driver — that can wedge the controller (probe -110) until a cold boot.</p>
    <p>Develop this plugin on a workstation, push to GitHub, then
    <code>plugin install https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main/thunderboltnet.plg</code>
    — do not ship by SCP into <code>/usr/local/emhttp/plugins/</code>.</p>
  </blockquote>

  <h3>Status</h3>
  <table class="tbn-table">
    <tr><td>Hostname</td><td><?= htmlspecialchars($status['hostname']) ?></td></tr>
    <tr><td>Domain security</td><td><code><?= htmlspecialchars($status['security'] ?: '(none/unknown)') ?></code></td></tr>
    <tr><td>Module <code>thunderbolt</code></td><td><?= !empty($mods['thunderbolt']) ? 'loaded' : 'not loaded' ?></td></tr>
    <tr><td>Module <code>thunderbolt_net</code></td><td><?= !empty($mods['thunderbolt_net']) ? 'loaded' : 'not loaded' ?></td></tr>
    <tr><td>include_interfaces</td><td><code><?= htmlspecialchars(implode(' ', $include) ?: '(empty)') ?></code></td></tr>
  </table>

  <h3>Thunderbolt devices</h3>
<?php if (!$devices): ?>
  <p class="tbn-muted">No entries under <code>/sys/bus/thunderbolt/devices</code> (controller down, or no domain yet).</p>
<?php else: ?>
  <table class="tbn-table tbn-wide">
    <thead>
      <tr>
        <th>ID</th><th>Name</th><th>Vendor</th><th>RX / TX</th><th>Lanes</th><th>Netdevs</th>
      </tr>
    </thead>
    <tbody>
<?php foreach ($devices as $d): ?>
      <tr>
        <td><code><?= htmlspecialchars($d['id']) ?></code></td>
        <td><?= htmlspecialchars($d['device_name'] ?: '—') ?></td>
        <td><?= htmlspecialchars($d['vendor_name'] ?: '—') ?></td>
        <td><?= htmlspecialchars(trim(($d['rx_speed'] ?: '—') . ' / ' . ($d['tx_speed'] ?: '—'))) ?></td>
        <td><?= htmlspecialchars(trim(($d['rx_lanes'] ?: '—') . ' / ' . ($d['tx_lanes'] ?: '—'))) ?></td>
        <td><code><?= htmlspecialchars($d['netdevs'] ? implode(', ', $d['netdevs']) : '—') ?></code></td>
      </tr>
<?php endforeach; ?>
    </tbody>
  </table>
<?php endif; ?>

  <h3>Thunderbolt netdevs</h3>
<?php if (!$netdevs): ?>
  <p class="tbn-muted">No <code>thunderbolt*</code> / <code>bond-tb</code> interfaces. Peer link + <code>thunderbolt_net</code> required first.</p>
<?php else: ?>
  <table class="tbn-table tbn-wide">
    <thead>
      <tr><th>Iface</th><th>State</th><th>Carrier</th><th>MAC</th><th>IPv4</th></tr>
    </thead>
    <tbody>
<?php foreach ($netdevs as $n): ?>
      <tr>
        <td><code><?= htmlspecialchars($n['iface']) ?></code></td>
        <td><?= htmlspecialchars($n['operstate']) ?></td>
        <td><?= htmlspecialchars($n['carrier'] === '' ? 'n/a' : $n['carrier']) ?></td>
        <td><code><?= htmlspecialchars($n['address']) ?></code></td>
        <td><code><?= htmlspecialchars($n['addrs'] ? implode(', ', $n['addrs']) : '—') ?></code></td>
      </tr>
<?php endforeach; ?>
    </tbody>
  </table>
<?php endif; ?>

  <h3>Actions</h3>
  <form method="POST" action="/update.php" target="progressFrame">
    <input type="hidden" name="#file" value="ThunderboltNet/ThunderboltNet.cfg">
    <input type="hidden" name="#include" value="/plugins/ThunderboltNet/include/tbn-update.php">
    <dl class="tbn-form">
      <dt>Load modules at apply</dt>
      <dd>
        <select name="load_modules">
          <option value="yes" <?= ($cfg['load_modules'] ?? 'yes') === 'yes' ? 'selected' : '' ?>>Yes</option>
          <option value="no" <?= ($cfg['load_modules'] ?? '') === 'no' ? 'selected' : '' ?>>No</option>
        </select>
        <span class="tbn-hint">modprobe thunderbolt + thunderbolt_net (no NHI unbind).</span>
      </dd>

      <dt>E2E flow control</dt>
      <dd>
        <select name="e2e_flow_control">
          <option value="no" <?= ($cfg['e2e_flow_control'] ?? 'no') === 'no' ? 'selected' : '' ?>>No (e2e=0, often better cross-host)</option>
          <option value="yes" <?= ($cfg['e2e_flow_control'] ?? '') === 'yes' ? 'selected' : '' ?>>Yes (driver default)</option>
        </select>
      </dd>

      <dt>Include listening interfaces</dt>
      <dd>
        <select name="include_listening">
          <option value="no" <?= ($cfg['include_listening'] ?? 'no') === 'no' ? 'selected' : '' ?>>No</option>
          <option value="yes" <?= ($cfg['include_listening'] ?? '') === 'yes' ? 'selected' : '' ?>>Yes — add live thunderbolt*/bond-tb to network-extra.cfg</option>
        </select>
        <span class="tbn-hint">Same idea as Tailscale’s include list. Only ifaces that exist are added. Does not create TB devices.</span>
      </dd>

      <dt>Manage static IP</dt>
      <dd>
        <select name="manage_ip">
          <option value="no" <?= ($cfg['manage_ip'] ?? 'no') === 'no' ? 'selected' : '' ?>>No</option>
          <option value="yes" <?= ($cfg['manage_ip'] ?? '') === 'yes' ? 'selected' : '' ?>>Yes — apply on save (CLI ip addr)</option>
        </select>
      </dd>

      <dt>Primary iface</dt>
      <dd><input type="text" name="iface_primary" value="<?= htmlspecialchars($cfg['iface_primary'] ?? 'thunderbolt0') ?>" class="narrow"></dd>

      <dt>Secondary iface</dt>
      <dd><input type="text" name="iface_secondary" value="<?= htmlspecialchars($cfg['iface_secondary'] ?? 'thunderbolt1') ?>" class="narrow"> <span class="tbn-hint">for dual cable / include list</span></dd>

      <dt>IPv4 address</dt>
      <dd><input type="text" name="ip_addr" value="<?= htmlspecialchars($cfg['ip_addr'] ?? '10.255.1.2') ?>" class="narrow"></dd>

      <dt>Prefix length</dt>
      <dd><input type="text" name="ip_cidr" value="<?= htmlspecialchars($cfg['ip_cidr'] ?? '24') ?>" class="narrow"></dd>

      <dt>Never default route</dt>
      <dd>
        <select name="never_default">
          <option value="yes" <?= ($cfg['never_default'] ?? 'yes') === 'yes' ? 'selected' : '' ?>>Yes (recommended)</option>
          <option value="no" <?= ($cfg['never_default'] ?? '') === 'no' ? 'selected' : '' ?>>No</option>
        </select>
      </dd>
    </dl>
    <input type="submit" name="#apply" value="Apply">
    <input type="button" value="Refresh status" onclick="location.reload()">
  </form>

  <h3>CLI</h3>
  <pre class="tbn-pre"># On Unraid after plugin install:
php /usr/local/emhttp/plugins/ThunderboltNet/include/get-status.php
/usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-status</pre>

  <p class="tbn-muted">Version <code><?= htmlspecialchars($ver) ?></code> ·
  <a href="https://github.com/ibigsnet/ThunderboltNet" target="_blank" rel="noopener">GitHub</a></p>
</div>
<script src="/plugins/ThunderboltNet/thunderboltnet.js?v=<?= htmlspecialchars($ver) ?>"></script>
