          }
          break;
        }
      }
    }
    $pref = (($p['include_listening'] ?? 'no') === 'yes') ? 'yes' : 'no';
    $live_on = false;
    if ($online && $if !== '') {
      $live_on = in_array($if, $include, true);
    }
    $can_apply_live = ($online && $if !== '' && preg_match('/^thunderbolt\d+$/', $if));
