<script>
(function () {
  // Scope to .tbn-wrap only — never touch Unraid Network Settings tab strip.
  var root = document.querySelector('.tbn-wrap');
  if (!root) return;
  function activate(name) {
    var tabs = root.querySelectorAll('[data-tbn-tab]');
    var panels = {
      status: root.querySelector('[data-tbn-panel="status"]'),
      peers: root.querySelector('[data-tbn-panel="peers"]'),
      hardware: root.querySelector('[data-tbn-panel="hardware"]'),
      settings: root.querySelector('[data-tbn-panel="settings"]')
    };
    if (!panels[name]) name = 'status';
    tabs.forEach(function (btn) {
      btn.classList.toggle('is-active', btn.getAttribute('data-tbn-tab') === name);
    });
    Object.keys(panels).forEach(function (k) {
      if (!panels[k]) return;
      if (k === name) panels[k].removeAttribute('hidden');
      else panels[k].setAttribute('hidden', 'hidden');
    });
    try {
      if (window.history && window.history.replaceState) {
        var u = new URL(window.location.href);
        u.searchParams.set('tbn_tab', name);
        window.history.replaceState({}, '', u.toString());
      }
      sessionStorage.setItem('tbnInnerTab', name);
    } catch (e) {}
  }
  root.querySelectorAll('[data-tbn-tab]').forEach(function (btn) {
    btn.addEventListener('click', function (ev) {
      ev.preventDefault();
      ev.stopPropagation();
      activate(btn.getAttribute('data-tbn-tab'));
    });
  });
  // Used by mesh panel / other panels already on Network Settings
  window.tbnActivateInnerTab = activate;
  try {
    var q = new URL(window.location.href).searchParams.get('tbn_tab');
    var saved = sessionStorage.getItem('tbnInnerTab');
    var want = q || saved;
    if (want) activate(want);
    var expand = sessionStorage.getItem('tbnWantExpand');
    if (expand) {
      sessionStorage.removeItem('tbnWantExpand');
      setTimeout(function () {
        var toggle = root.querySelector('[data-tbn-adv-toggle="' + expand + '"]');
        var body = document.getElementById('tbn-adv-' + expand);
        if (toggle && body && body.hasAttribute('hidden')) {
          toggle.click();
        }
        if (body) {
          try { body.scrollIntoView({ block: 'nearest' }); } catch (e2) {}
        }
      }, 80);
    }
  } catch (e) {}
})();
</script>
