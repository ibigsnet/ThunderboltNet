<script>
(function () {
  function activate(name) {
    var tabs = document.querySelectorAll('[data-tbn-tab]');
    var panels = {
      status: document.getElementById('tbn-panel-status'),
      peers: document.getElementById('tbn-panel-peers'),
      hardware: document.getElementById('tbn-panel-hardware'),
      settings: document.getElementById('tbn-panel-settings')
    };
    if (!panels[name]) name = 'status';
    tabs.forEach(function (btn) {
      var on = btn.getAttribute('data-tbn-tab') === name;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    Object.keys(panels).forEach(function (k) {
      if (!panels[k]) return;
      if (k === name) panels[k].removeAttribute('hidden');
      else panels[k].setAttribute('hidden', 'hidden');
    });
    try {
      if (window.history && window.history.replaceState) {
        var u = new URL(window.location.href);
        u.searchParams.set('tbn_tab', name);
        window.history.replaceState({}, '', u.toString());
      }
      sessionStorage.setItem('tbnInnerTab', name);
    } catch (e) {}
  }
  document.querySelectorAll('[data-tbn-tab]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      activate(btn.getAttribute('data-tbn-tab'));
    });
  });
  // Deep-link / restore
  try {
    var q = new URL(window.location.href).searchParams.get('tbn_tab');
    var saved = sessionStorage.getItem('tbnInnerTab');
    if (q) activate(q);
    else if (saved) activate(saved);
  } catch (e) {}
})();
</script>
