<?php
/**
 * Overview tab (after wlan :1000). Per-link tabs: Thunderbolt tbn0, tbn1, ...
 * IMPORTANT: never use __DIR__ here — Unraid evaluates pages under a different cwd.
 */
require_once '/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php';

$plugin = 'ThunderboltNet';
$cfg = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : tbn_load_cfg();
if (!is_array($cfg)) {
  $cfg = tbn_load_cfg();
} else {
  $cfg = array_merge(tbn_load_cfg(), $cfg);
}

// Ensure per-iface Network Settings tabs exist for live thunderbolt*
tbn_sync_iface_pages();

$status = tbn_status();
$mods = $status['modules'];
$devices = $status['devices'];
$netdevs = $status['netdevs'];
$include = $status['include_interfaces'];
$has_hw = !empty($status['has_hardware']);
$diag = tbn_diagnostics_text();
$pci = tbn_list_pci_iommu();
$ver = tbn_plugin_version();
$ifaces = tbn_list_tb_iface_names();

$mod_tb = !empty($mods['thunderbolt']) ? 'loaded' : 'not loaded';
$mod_net = !empty($mods['thunderbolt_net']) ? 'loaded' : 'not loaded';
$peer_count = 0;
foreach ($devices as $d) {
  if (preg_match('/^\d+-\d+$/', $d['id']) && $d['id'] !== '0-0' && ($d['device_name'] !== '' || $d['rx_speed'] !== '')) {
    $peer_count++;
  }
}
$issues_url = 'https://github.com/ibigsnet/ThunderboltNet/issues';
?>
<link rel="stylesheet" href="/plugins/ThunderboltNet/thunderboltnet.css?v=<?= htmlspecialchars($ver) ?>">

<div class="tbn-wrap">
  <div class="tbn-hero">
    <h3 class="tbn-title">Thunderbolt / USB4 networking</h3>
  </div>

<?php if (!$has_hw): ?>
  <div class="tbn-notice tbn-notice-warn" role="status">
    <h4>No Thunderbolt hardware detected on this server</h4>
    <p>
      No Thunderbolt / USB4 host controller is visible to Linux (no matching PCI device and no
      <code>/sys/bus/thunderbolt</code> domain).
      <strong>You do not need this plugin on this machine</strong> unless you add TB hardware later.
    </p>
    <p>
      If this looks wrong, copy the diagnostics below and open a GitHub issue:
      <a href="<?= htmlspecialchars($issues_url) ?>" target="_blank" rel="noopener"><?= htmlspecialchars($issues_url) ?></a>
    </p>
    <label class="tbn-diag-label" for="tbn-diagnostics">Hardware diagnostics (safe to paste publicly)</label>
    <textarea id="tbn-diagnostics" class="tbn-diag" readonly rows="16" spellcheck="false"><?= htmlspecialchars($diag) ?></textarea>
    <p class="tbn-diag-actions">
      <input type="button" value="Copy diagnostics" onclick="tbnCopyDiagnostics()">
      <input type="button" value="Refresh" onclick="location.reload()">
      <input type="button" value="Done" onclick="done()">
    </p>
  </div>
<?php else: ?>

  <blockquote class="inline_help">
    <p>Live links appear as tabs <strong>Thunderbolt tbn0</strong>, <strong>tbn1</strong>, … (kernel
    <code>thunderbolt0</code>, …). This page is controller status, modules, and PCI/IOMMU/VFIO.</p>
    <p>Thunderbolt netdevs are hotplug; they are not configured like boot-time eth interfaces in
    <code>network.cfg</code>. Use real Thunderbolt 4 / USB4 cables. Do not unbind the Thunderbolt NHI
    from the host driver (can wedge the controller until a cold boot).</p>
  </blockquote>

  <h3>Summary</h3>
  <table class="tbn-table tbn-summary">
    <tr><td>Hostname</td><td><?= htmlspecialchars($status['hostname']) ?></td></tr>
    <tr><td>Domain security</td><td><code><?= htmlspecialchars($status['security'] ?: '(none/unknown)') ?></code></td></tr>
    <tr><td>Modules</td><td><code>thunderbolt</code> <?= htmlspecialchars($mod_tb) ?> · <code>thunderbolt_net</code> <?= htmlspecialchars($mod_net) ?></td></tr>
    <tr><td>Peers / ifaces</td><td><?= (int)$peer_count ?> peer(s) · <?= count($ifaces) ?> iface(s)</td></tr>
    <tr><td>Interface tabs</td>
      <td>
<?php if (!$ifaces): ?>
        <span class="tbn-muted">None yet — connect a cable/peer, then Refresh (tabs: tbn0, tbn1, …)</span>
<?php else: ?>
<?php foreach ($ifaces as $if): $lb = tbn_label_for_iface($if); ?>
        <a href="/Settings/Tbn<?= (int)substr($if, strlen('thunderbolt')) ?>"><code><?= htmlspecialchars($lb) ?></code></a>
        <span class="tbn-muted">(= <?= htmlspecialchars($if) ?>)</span>
<?php endforeach; ?>
<?php endif; ?>
      </td>
    </tr>
    <tr><td>Listening includes</td><td><code><?= htmlspecialchars(implode(' ', $include) ?: '(empty)') ?></code></td></tr>
  </table>

  <h3>Controller PCI / IOMMU / VFIO</h3>
  <p class="tbn-muted">If the NHI is bound to <code>vfio-pci</code>, the host cannot use Thunderbolt networking.</p>
<?php if (!$pci): ?>
  <p class="tbn-muted">No TB-related PCI rows found.</p>
<?php else: ?>
  <table class="tbn-table tbn-wide">
    <thead>
      <tr><th>PCI BDF</th><th>IOMMU group</th><th>Driver</th><th>VFIO</th><th>Description</th></tr>
    </thead>
    <tbody>
<?php foreach ($pci as $p): ?>
      <tr>
        <td><code><?= htmlspecialchars($p['bdf']) ?></code></td>
        <td><code><?= htmlspecialchars($p['iommu_group']) ?></code></td>
        <td><code><?= htmlspecialchars($p['driver']) ?></code></td>
        <td><?= htmlspecialchars($p['vfio']) ?><?= $p['vfio_boot_cfg'] === 'yes' ? ' (boot cfg)' : '' ?></td>
        <td><?= htmlspecialchars($p['description']) ?></td>
      </tr>
<?php endforeach; ?>
    </tbody>
  </table>
<?php endif; ?>

  <h3>Thunderbolt devices</h3>
<?php if (!$devices): ?>
  <p class="tbn-muted">No sysfs device entries.</p>
<?php else: ?>
  <table class="tbn-table tbn-wide">
    <thead>
      <tr><th>ID</th><th>Name</th><th>Vendor</th><th>RX / TX</th><th>Lanes</th><th>Netdevs</th></tr>
    </thead>
    <tbody>
<?php foreach ($devices as $d): ?>
      <tr>
        <td><code><?= htmlspecialchars($d['id']) ?></code></td>
        <td><?= htmlspecialchars($d['device_name'] ?: '—') ?></td>
        <td><?= htmlspecialchars($d['vendor_name'] ?: '—') ?></td>
        <td><?= htmlspecialchars(trim(($d['rx_speed'] ?: '—') . ' / ' . ($d['tx_speed'] ?: '—'))) ?></td>
        <td><?= htmlspecialchars(trim(($d['rx_lanes'] ?: '—') . ' / ' . ($d['tx_lanes'] ?: '—'))) ?></td>
        <td><code><?= htmlspecialchars($d['netdevs'] ? implode(', ', $d['netdevs']) : '—') ?></code></td>
      </tr>
<?php endforeach; ?>
    </tbody>
  </table>
<?php endif; ?>

  <h3>Global driver options</h3>
  <form markdown="1" method="POST" action="/update.php" target="progressFrame">
  <input type="hidden" name="#file" value="ThunderboltNet/ThunderboltNet.cfg">
  <input type="hidden" name="#include" value="/plugins/ThunderboltNet/include/tbn-update.php">
  <input type="hidden" name="tbn_defaults" value="">

**Load modules when applying**
: <select name="load_modules">
  <?= mk_option($cfg['load_modules'] ?? 'yes', 'yes', 'Yes') ?>
  <?= mk_option($cfg['load_modules'] ?? 'yes', 'no', 'No') ?>
  </select>

: <code>modprobe thunderbolt</code> + <code>thunderbolt_net</code> (never NHI unbind).

**E2E flow control**
: <select name="e2e_flow_control">
  <?= mk_option($cfg['e2e_flow_control'] ?? 'no', 'no', 'No (e2e=0 — often better cross-host)') ?>
  <?= mk_option($cfg['e2e_flow_control'] ?? 'no', 'yes', 'Yes (driver default)') ?>
  </select>

: Cross-host links often work better with e2e=0.

&nbsp;
: <input type="submit" name="#apply" value="Apply"><input type="button" value="Refresh" onclick="location.reload()"><input type="button" value="Done" onclick="done()">

  </form>

<?php endif; ?>

  <p class="tbn-muted tbn-footer">
    Version <code><?= htmlspecialchars($ver) ?></code>
    · <a href="https://github.com/ibigsnet/ThunderboltNet" target="_blank" rel="noopener">GitHub</a>
    · Settings → Network Settings → Thunderbolt / tbnN
  </p>
</div>
<script src="/plugins/ThunderboltNet/thunderboltnet.js?v=<?= htmlspecialchars($ver) ?>"></script>
