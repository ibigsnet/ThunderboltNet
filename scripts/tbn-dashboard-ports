#!/bin/bash
# Include Thunderbolt host-net ifaces on Unraid Dashboard network throughput.
#
# Stock dynamix only lists bondN / ethN / wlanN (+ lo). Kernel names for this
# plugin are thunderboltN (Settings tabs tbn0, tbn1, …), plus optional bond-tbN
# and br-tbN. Patch (content only — one grep line each file):
#   - plugins/dynamix/nchan/update_3     (nchan worker: net stats + Dashboard clock)
#   - plugins/dynamix/DashStats.page     (UI port list for Interface dropdown)
#
# INCIDENT (2026.08.16): early replace used mktemp+mv which dropped file mode.
# update_3 lost +x → nchan worker never stayed up → Dashboard clock frozen/missing
# for anyone who ran apply. Fixed 2026.08.16af+ (preserve mode, self-heal, restart).
# See docs/dashboard-ports-and-clock.md
#
# Usage: tbn-dashboard-ports apply|remove|status
# No python3 required (Unraid stock often lacks it).

set -euo pipefail

MARKER='ThunderboltNet-dashboard-ports'
UPDATE3="/usr/local/emhttp/plugins/dynamix/nchan/update_3"
DASH="/usr/local/emhttp/plugins/dynamix/DashStats.page"
BACKUP_DIR="/boot/config/plugins/ThunderboltNet/dashboard-ports-backup"

# Literal substrings as they appear in LimeTech files
STOCK="grep -Po '^(bond|eth|wlan)\\d+$'"
PATCHED="grep -Po '^(bond|eth|wlan|thunderbolt)\\d+$|^(bond-tb|br-tb)\\d+$' # ${MARKER}"

# Unraid event/started captures stdout into the bottom status bar
# ("Array Started • …"). Keep routine success quiet unless a TTY or VERBOSE=1.
log() {
  local msg="ThunderboltNet dashboard-ports: $*"
  logger -t ThunderboltNet "dashboard-ports: $*" 2>/dev/null || true
  if [ -t 1 ] || [ "${TBN_DASH_VERBOSE:-0}" = "1" ]; then
    echo "$msg"
  fi
}

# Real problems only — may appear on array-start status bar intentionally.
warn() {
  local msg="ThunderboltNet dashboard-ports: $*"
  logger -t ThunderboltNet "dashboard-ports: $*" 2>/dev/null || true
  echo "$msg" >&2
}

backup_once() {
  local f="$1" base
  base=$(basename "$f")
  mkdir -p "$BACKUP_DIR"
  if [ ! -f "$BACKUP_DIR/$base.stock" ]; then
    cp -a "$f" "$BACKUP_DIR/$base.stock"
    log "backed up stock $base → $BACKUP_DIR/$base.stock"
  fi
}

# Restore mode from stock backup when present; else sensible defaults.
# nchan workers: 755. DashStats.page: 644 (stock Unraid).
heal_mode() {
  local f="$1" base mode
  base=$(basename "$f")
  [ -f "$f" ] || return 0
  if [ -f "$BACKUP_DIR/$base.stock" ]; then
    mode=$(stat -c '%a' "$BACKUP_DIR/$base.stock" 2>/dev/null || true)
  fi
  if [ -z "${mode:-}" ]; then
    if [ "$base" = "update_3" ]; then
      mode=755
    else
      mode=644
    fi
  fi
  chmod "$mode" "$f" 2>/dev/null || true
  # update_3 must be executable even if stock backup was wrong
  if [ "$base" = "update_3" ] && [ ! -x "$f" ]; then
    chmod 755 "$f" 2>/dev/null || true
  fi
}

# Replace first occurrence of $old with $new in file (bash only).
# Never use mv over the target from a temp file without restoring mode —
# that dropped +x on update_3 and broke the Dashboard clock (nchan).
replace_first() {
  local f="$1" old="$2" new="$3"
  local tmp done=0 line mode
  mode=$(stat -c '%a' "$f" 2>/dev/null || echo 644)
  tmp=$(mktemp)
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$done" -eq 0 ] && [[ "$line" == *"$old"* ]]; then
      line="${line/"$old"/$new}"
      done=1
    fi
    printf '%s\n' "$line"
  done <"$f" >"$tmp"
  if [ "$done" -eq 1 ]; then
    cat "$tmp" >"$f"
    rm -f "$tmp"
    chmod "$mode" "$f" 2>/dev/null || true
    heal_mode "$f"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

apply_file() {
  local f="$1"
  if [ ! -f "$f" ]; then
    log "skip missing $f"
    return 0
  fi
  if grep -qF "$MARKER" "$f" 2>/dev/null; then
    heal_mode "$f"
    log "already applied: $f (mode $(stat -c '%a' "$f" 2>/dev/null || echo '?'))"
    return 0
  fi
  if ! grep -qF "grep -Po '^(bond|eth|wlan)" "$f" 2>/dev/null; then
    warn "WARN: ports grep not found in $f — Unraid layout may have changed; skip"
    return 0
  fi
  backup_once "$f"
  if replace_first "$f" "$STOCK" "$PATCHED"; then
    heal_mode "$f"
    log "applied: $f (mode $(stat -c '%a' "$f" 2>/dev/null || echo '?'))"
  else
    warn "WARN: failed to patch $f (stock pattern not exact match)"
  fi
}

remove_file() {
  local f="$1" base
  base=$(basename "$f")
  if [ ! -f "$f" ]; then
    return 0
  fi
  if [ -f "$BACKUP_DIR/$base.stock" ]; then
    if grep -qF "$MARKER" "$f" 2>/dev/null || grep -q 'thunderbolt' "$f" 2>/dev/null; then
      cp -a "$BACKUP_DIR/$base.stock" "$f"
      heal_mode "$f"
      log "restored stock: $f"
    fi
    return 0
  fi
  if grep -qF "$MARKER" "$f" 2>/dev/null; then
    if replace_first "$f" "$PATCHED" "$STOCK"; then
      heal_mode "$f"
      log "reverted: $f"
    else
      local tmp mode
      mode=$(stat -c '%a' "$f" 2>/dev/null || echo 644)
      tmp=$(mktemp)
      while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" == *"$MARKER"* ]]; then
          line="${line//$PATCHED/$STOCK}"
          if [[ "$line" == *"$MARKER"* ]]; then
            line=$(printf '%s\n' "$line" | sed "s/grep -Po '[^']*'/grep -Po '^(bond|eth|wlan)\\\\d+\$'/")
          fi
        fi
        printf '%s\n' "$line"
      done <"$f" >"$tmp"
      cat "$tmp" >"$f"
      rm -f "$tmp"
      chmod "$mode" "$f" 2>/dev/null || true
      heal_mode "$f"
      log "reverted (fallback): $f"
    fi
  fi
}

restart_nchan_update3() {
  if [ -f "$UPDATE3" ]; then
    heal_mode "$UPDATE3"
  fi
  local pid
  for pid in $(pgrep -f 'php -q .*/nchan/update_3' 2>/dev/null || true); do
    if tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'nchan/update_3'; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  sleep 0.3
  if [ -f "$UPDATE3" ] && [ -x "$UPDATE3" -o -r "$UPDATE3" ]; then
    nohup /usr/bin/php -q "$UPDATE3" >/dev/null 2>&1 &
    log "restarted nchan update_3 (Dashboard network + clock)"
  else
    warn "WARN: cannot start update_3 (missing or unreadable)"
  fi
}

status_file() {
  local f="$1" mode exe worker
  if [ ! -f "$f" ]; then
    echo "  missing: $f"
    return
  fi
  mode=$(stat -c '%a' "$f" 2>/dev/null || echo '?')
  if [ -x "$f" ]; then exe=yes; else exe=no; fi
  if grep -qF "$MARKER" "$f" 2>/dev/null; then
    echo "  patched: $f  mode=$mode executable=$exe"
  elif grep -qF "$STOCK" "$f" 2>/dev/null; then
    echo "  stock:   $f  mode=$mode executable=$exe"
  else
    echo "  other:   $f  mode=$mode executable=$exe"
  fi
}

status_workers() {
  local n
  n=$(pgrep -fc 'php -q .*/nchan/update_3' 2>/dev/null || echo 0)
  if pgrep -f 'php -q .*/nchan/update_3' >/dev/null 2>&1; then
    echo "  update_3 worker: running (count~$(pgrep -f 'php -q .*/nchan/update_3' 2>/dev/null | wc -l))"
  else
    echo "  update_3 worker: NOT running (Dashboard clock/net tile will freeze)"
  fi
  echo "  other nchan (sample): update_1=$(pgrep -c -f 'nchan/update_1' 2>/dev/null || echo 0) update_2=$(pgrep -c -f 'nchan/update_2' 2>/dev/null || echo 0)"
}

cmd="${1:-status}"
case "$cmd" in
  apply)
    apply_file "$UPDATE3"
    apply_file "$DASH"
    restart_nchan_update3
    if [ -t 1 ] || [ "${TBN_DASH_VERBOSE:-0}" = "1" ]; then
      log "done — hard-refresh Dashboard; choose thunderbolt0 in the Interface dropdown"
    else
      log "apply complete"
    fi
    ;;
  remove)
    remove_file "$UPDATE3"
    remove_file "$DASH"
    restart_nchan_update3
    log "removed dashboard port patches"
    ;;
  status)
    echo "ThunderboltNet dashboard-ports: status"
    status_file "$UPDATE3"
    status_file "$DASH"
    status_workers
    echo "  (only these two dynamix files are patched; see docs/dashboard-ports-and-clock.md)"
    ;;
  heal)
    # Fix modes + worker without re-patching content
    heal_mode "$UPDATE3"
    heal_mode "$DASH"
    restart_nchan_update3
    log "heal complete"
    status_file "$UPDATE3"
    status_file "$DASH"
    status_workers
    ;;
  *)
    echo "Usage: $0 apply|remove|status|heal" >&2
    exit 2
    ;;
esac
