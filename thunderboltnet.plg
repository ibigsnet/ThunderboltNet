<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "ThunderboltNet">
<!ENTITY author "RifleJock">
<!--
  Versioning — Unraid plugin updates use strcmp() (lexicographic), NOT version_compare.
  No hyphens. Bump only this entity; asset ?v= uses it.

  Rules (same as StorageGuard):
    YYYY.MM.DD       first release that calendar day
    YYYY.MM.DDaa     2nd same day, then ab, ac, ... az, ba, bb, ...
  Two-letter only after the bare date — never single a–z on new days
  (avoids strcmp treating "aa" as older than "z").
-->
<!ENTITY version "2026.07.29ah">
<!ENTITY launch "Settings/ThunderboltNet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main/thunderboltnet.plg">
<!ENTITY github "ibigsnet/ThunderboltNet">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main">
<!ENTITY plugdir "/usr/local/emhttp/plugins/ThunderboltNet">
<!ENTITY configdir "/boot/config/plugins/ThunderboltNet">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="sitemap"
  min="6.12.0"
  support="https://github.com/&github;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- Thorough uninstall: remove emhttp trees (both casings), boot plugin dirs, tmp plugin files, modprobe snippets under /etc and /boot, TB entries from network-extra; no leftover empty dirs blocking reinstall.

###2026.07.29ag
- Restore plugin package after empty .plg publish; Network Settings tab and host-to-host TB LAN UX.

###2026.07.29ae
- CLI/JSON status over SSH; cfg readable without web context.

###2026.07.29ad
- Settings help: cable/NHI safety notes.

###2026.07.29ac
- Install wipe + remove of emhttp plugin tree.

###2026.07.29ab
- Install via Plugins → Install Plugin with the raw .plg URL.

###2026.07.29aa
- Initial release: TB status, module load, optional listening interfaces and static IP.

</CHANGES>

<!--
  Install prep (StorageGuard pattern):
  Unraid will NOT overwrite FILE targets that already exist. Always wipe the
  emhttp plugin tree, then recreate empty dirs, before downloading assets.
  Do NOT wipe /boot/config/plugins/ThunderboltNet (user settings).
-->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: preparing directories..."
rm -rf /usr/local/emhttp/plugins/ThunderboltNet
rm -rf /usr/local/emhttp/plugins/thunderboltnet
mkdir -p /usr/local/emhttp/plugins/ThunderboltNet/include
mkdir -p /usr/local/emhttp/plugins/ThunderboltNet/scripts
mkdir -p /boot/config/plugins/ThunderboltNet
echo "ThunderboltNet: directories ready."
]]></INLINE>
</FILE>

<!-- Plugin UI + assets -->
<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/ThunderboltNet.page">
<URL>&raw;/ThunderboltNet.page?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/default.cfg">
<URL>&raw;/default.cfg?v=&version;</URL>
</FILE>

<!--
  Plugins page: Markdown(file_get_contents(README.md)) for the description.
  INLINE so install never depends on a stale GitHub raw CDN README.
  Repo README.md matches.
-->
<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/README.md">
<INLINE>
<![CDATA[
**Thunderbolt Net**

Host-to-host Thunderbolt / USB4 networking on Unraid: discover peers and link speed, load drivers safely, optional static IP and listening-interface include for a high-bandwidth private LAN (bulk transfers without saturating Ethernet). Lives under Network Settings.
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/thunderboltnet.css">
<URL>&raw;/thunderboltnet.css?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/thunderboltnet.js">
<URL>&raw;/thunderboltnet.js?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php">
<URL>&raw;/include/tbn-lib.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/include/get-status.php">
<URL>&raw;/include/get-status.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-apply.php">
<URL>&raw;/include/tbn-apply.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-update.php">
<URL>&raw;/include/tbn-update.php?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-status">
<URL>&raw;/scripts/tbn-status?v=&version;</URL>
</FILE>

<!-- Post-install: permissions + default cfg if missing -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: finishing install..."
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-status 2>/dev/null || true
if [ ! -f /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg ]; then
  if [ -f /usr/local/emhttp/plugins/ThunderboltNet/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/ThunderboltNet/default.cfg /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg
    echo "ThunderboltNet: created default ThunderboltNet.cfg"
  fi
fi
echo "ThunderboltNet: install complete. Settings → Network Settings → Thunderbolt Net (hard-refresh)."
ls -la /usr/local/emhttp/plugins/ThunderboltNet/ || true
]]></INLINE>
</FILE>

<!--
  ONLY on plugin remove (Unraid then moves the .plg to plugins-removed and
  drops /var/log/plugins symlink). Must leave the host clean for reinstall:
  no half-dead emhttp trees, no empty/orphan dirs, no modprobe leftovers.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "ThunderboltNet: removing plugin (full cleanup)..."

# --- 1) network-extra: drop TB ifaces we manage; keep others (e.g. tailscale1) ---
EXTRA=/boot/config/network-extra.cfg
if [ -f "$EXTRA" ]; then
  INC=$(sed -n 's/^include_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  EXC=$(sed -n 's/^exclude_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  NEW=""
  for if in $INC; do
    case "$if" in
      thunderbolt*|bond-tb|bond-tb*)
        echo "ThunderboltNet: dropping $if from include_interfaces"
        ;;
      *)
        NEW="${NEW}${NEW:+ }$if"
        ;;
    esac
  done
  {
    echo "include_interfaces=\"${NEW}\""
    echo "exclude_interfaces=\"${EXC}\""
  } > "$EXTRA"
  echo "ThunderboltNet: network-extra include_interfaces now: ${NEW:-(empty)}"
fi

# --- 2) modprobe options we wrote (runtime + boot copy). Do not rmmod thunderbolt. ---
for conf in \
  /etc/modprobe.d/thunderbolt_net.conf \
  /boot/config/modprobe.d/thunderbolt_net.conf
do
  if [ -f "$conf" ]; then
    if grep -q 'thunderbolt_net' "$conf" 2>/dev/null; then
      rm -f "$conf"
      echo "ThunderboltNet: removed $conf"
    fi
  fi
done
# Drop empty modprobe.d under boot if we emptied it (do not remove stock /etc/modprobe.d)
if [ -d /boot/config/modprobe.d ] && [ -z "$(ls -A /boot/config/modprobe.d 2>/dev/null)" ]; then
  rmdir /boot/config/modprobe.d 2>/dev/null || true
fi

# --- 3) Emhttp plugin trees (all casings / stray names) ---
rm -rf /usr/local/emhttp/plugins/ThunderboltNet
rm -rf /usr/local/emhttp/plugins/thunderboltnet
rm -rf /usr/local/emhttp/plugins/Thunderboltnet
# Generated per-iface pages if ever placed under webGui (future-safe)
rm -f /usr/local/emhttp/webGui/Thunderbolt*.page 2>/dev/null || true
rm -f /usr/local/emhttp/plugins/dynamix/Thunderbolt*.page 2>/dev/null || true

# --- 4) Boot plugin config + any bad/partial dirs (clean reinstall) ---
# Unraid keeps the .plg path itself until after this script; we clear our data dir.
rm -rf /boot/config/plugins/ThunderboltNet
rm -rf /boot/config/plugins/thunderboltnet
rm -rf /boot/config/plugins/Thunderboltnet

# --- 5) Transient download / status files ---
rm -f /tmp/plugins/thunderboltnet.plg 2>/dev/null || true
rm -f /tmp/plugins/thunderboltnet.txt 2>/dev/null || true
rm -f /tmp/plugins/ThunderboltNet* 2>/dev/null || true
rm -f /tmp/inline*-thunderboltnet.sh 2>/dev/null || true

# --- 6) Verify nothing critical left under emhttp ---
if [ -e /usr/local/emhttp/plugins/ThunderboltNet ] || [ -e /usr/local/emhttp/plugins/thunderboltnet ]; then
  echo "ThunderboltNet: WARNING — emhttp plugin path still present after rm"
  ls -la /usr/local/emhttp/plugins/ | grep -i thunder || true
else
  echo "ThunderboltNet: emhttp plugin paths clear"
fi

echo "ThunderboltNet: removed (boot settings and plugin files cleaned)."
echo "ThunderboltNet: reinstall via Plugins → Install Plugin + raw thunderboltnet.plg URL."
]]></INLINE>
</FILE>

</PLUGIN>
