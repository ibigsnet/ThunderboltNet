<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "ThunderboltNet">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.08.15ag">
<!ENTITY launch "Settings/ThunderboltNet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main/thunderboltnet.plg">
<!ENTITY github "ibigsnet/ThunderboltNet">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main">
<!ENTITY forum "https://forums.unraid.net/topic/200065-plugin-thunderbolt-net-host-to-host-networking-over-thunderbolt-345-and-usb44v2/">
<!ENTITY plugdir "/usr/local/emhttp/plugins/ThunderboltNet">
<!ENTITY configdir "/boot/config/plugins/ThunderboltNet">
<!ENTITY pkg "ThunderboltNet-&version;-x86_64-1">
<!ENTITY pkgfile "&pkg;.txz">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="sitemap"
  min="6.12.0"
  support="&forum;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/stable/README.md">

<CHANGES>
###&version;
- **Uninstall:** remove all plugin-owned flash config and runtime scratch (clean reinstall).
- No longer preserve peers.json/ifaces on flash after remove.

###2026.08.15af
- Fix: do not wipe Unraid /tmp/plugins working copy during install prepare.

###2026.08.14ap
- **Fix:** Cables and safety help link showed literal “Directionality &amp; speeds” (double-escaped
  label). Same for Peers / MTU / bonding doc footers that used pre-encoded ampersands.

###2026.08.14ao
- Fabric reports: clear LAN peer-to-peer wording (not cloud/telemetry); TB and optional eth paths;
  off-message path + clickable jump to Settings → Show Fabric reports.

###2026.08.14an
- Fabric reports off message path + <code>tbnGotoFabricReportsSettings</code> jump.

###2026.08.14am
- Status: restore summary table rows; short per-field Help text (no meta UI notes in user copy).

###2026.08.14al
- Status: per-field inline_help for This host.

### Older releases
- Full changelog (all versions): https://github.com/ibigsnet/ThunderboltNet/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: preparing..."
# Note: do not delete /tmp/plugins/thunderboltnet.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/ThunderboltNet
rm -rf /usr/local/emhttp/plugins/ThunderboltNet
rm -f /boot/config/plugins/ThunderboltNet/ThunderboltNet-*.txz 2>/dev/null || true
echo "ThunderboltNet: ready."
]]></INLINE>
</FILE>

<FILE Name="/boot/config/plugins/ThunderboltNet/&pkgfile;" Run="upgradepkg --install-new --reinstall">
<URL>&raw;/archive/&pkgfile;?v=&version;</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: finishing install..."
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/event/started 2>/dev/null || true
mkdir -p /boot/config/plugins/ThunderboltNet
if [ ! -f /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg ] \
   && [ -f /usr/local/emhttp/plugins/ThunderboltNet/default.cfg ]; then
  cp -a /usr/local/emhttp/plugins/ThunderboltNet/default.cfg /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg
fi
if [ -f /usr/local/emhttp/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt ]; then
  cp -a /usr/local/emhttp/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt \
    /boot/config/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt
fi
echo "ThunderboltNet: install complete. Settings → Network Settings → Thunderbolt"
echo "ThunderboltNet: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "ThunderboltNet: removing..."
# Drop TB ifaces from network-extra include list (keep other includes)
EXTRA=/boot/config/network-extra.cfg
if [ -f "$EXTRA" ]; then
  INC=$(sed -n 's/^include_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  EXC=$(sed -n 's/^exclude_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  NEW=""
  for if in $INC; do
    case "$if" in
      thunderbolt*|bond-tb|bond-tb*|br-tb) ;;
      *) NEW="${NEW}${NEW:+ }$if" ;;
    esac
  done
  {
    echo "include_interfaces=\"${NEW}\""
    echo "exclude_interfaces=\"${EXC}\""
  } > "$EXTRA"
fi
for conf in /etc/modprobe.d/thunderbolt_net.conf /boot/config/modprobe.d/thunderbolt_net.conf; do
  if [ -f "$conf" ] && grep -q 'thunderbolt_net' "$conf" 2>/dev/null; then
    rm -f "$conf"
  fi
done
if [ -d /boot/config/modprobe.d ] && [ -z "$(ls -A /boot/config/modprobe.d 2>/dev/null)" ]; then
  rmdir /boot/config/modprobe.d 2>/dev/null || true
fi
if [ -x /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports ]; then
  /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports remove || true
fi
# Package + emhttp
for p in /var/log/packages/ThunderboltNet-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /usr/local/emhttp/plugins/ThunderboltNet
# Flash config + runtime scratch (full uninstall — reinstall starts clean)
rm -rf /boot/config/plugins/ThunderboltNet
rm -rf /var/tmp/tbn-mesh-rl-* /tmp/tbn-uninstall-keep-* 2>/dev/null || true
rm -f /tmp/plugins/thunderboltnet.txt 2>/dev/null || true
# Note: do not delete /tmp/plugins/thunderboltnet.plg here — Unraid install working copy
# Note: do not touch /boot/config/plugins-removed/ (Unraid-owned)
echo "ThunderboltNet: removed."
]]></INLINE>
</FILE>

</PLUGIN>
