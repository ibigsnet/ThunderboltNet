<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "ThunderboltNet">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.09.08ac">
<!ENTITY launch "Settings/ThunderboltNet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/testing/thunderboltnet.plg">
<!ENTITY github "ibigsnet/ThunderboltNet">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/testing">
<!ENTITY forum "https://forums.unraid.net/topic/200065-plugin-thunderbolt-net-host-to-host-networking-over-thunderbolt-345-and-usb44v2/">
<!ENTITY plugdir "/usr/local/emhttp/plugins/ThunderboltNet">
<!ENTITY configdir "/boot/config/plugins/ThunderboltNet">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="bolt"
  min="6.12.0"
  support="&forum;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/testing/README.md">

<CHANGES>
###&version;
- Forget selected drops Known peers (csrf on lazy forms; live poll is read-only).

###2026.09.08aa–ab
- Mesh beacon binds Thunderbolt IPs; overlay install (do not wipe live plugin).

###2026.09.06aa–ab
- Hashed raw install (SHA256/MD5); state-changing endpoints require POST.

###2026.08.28ad–ac
- USB SuperSpeed aside; Jumbo / Desired MTU persists on Apply.

###2026.08.28aa–ab
- No-controller USB SuperSpeed banks; VFIO banner on Status/Peers/Settings/tbnN.

###2026.08.26aa
- Empty-state diagnostics: Unraid forum, GitHub Issues, Tools → Diagnostics.

###2026.08.25aa
- Hotplug DHCP stop; unknown peer defaults; tbn-last-good.

### Older releases
- Full changelog: https://github.com/ibigsnet/ThunderboltNet/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: preparing..."
# Note: do not delete /tmp/plugins/thunderboltnet.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/ThunderboltNet
# Forget old Slackware txz registration WITHOUT deleting the live tree.
# removepkg / rm -rf here ran before GitHub FILE copies; a failed download
# left Plugins on "error install".
for p in /var/log/packages/ThunderboltNet-*; do
  [ -e "$p" ] || continue
  echo "ThunderboltNet: forgetting old package $(basename "$p") (overlay files next)"
  rm -f "$p"
done
rm -rf /usr/local/emhttp/plugins/thunderboltnet \
       /usr/local/emhttp/plugins/Thunderboltnet 2>/dev/null || true
rm -f /boot/config/plugins/ThunderboltNet/ThunderboltNet-*.txz 2>/dev/null || true
mkdir -p /usr/local/emhttp/plugins/ThunderboltNet/{include,scripts,event,udev}
echo "ThunderboltNet: ready."
]]></INLINE>
</FILE>

