<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "ThunderboltNet">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.10.30ab">
<!ENTITY launch "Settings/ThunderboltNet">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main/thunderboltnet.plg">
<!ENTITY github "ibigsnet/ThunderboltNet">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/ThunderboltNet/main">
<!ENTITY forum "https://forums.unraid.net/topic/200065-plugin-thunderbolt-net-host-to-host-networking-over-thunderbolt-345-and-usb44v2/">
<!ENTITY plugdir "/usr/local/emhttp/plugins/ThunderboltNet">
<!ENTITY configdir "/boot/config/plugins/ThunderboltNet">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="bolt"
  min="6.12.0"
  support="&forum;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- Security and reliability: peer link check runs on a schedule with results in RAM; NAT, OpenFabric and DHCP on Thunderbolt no longer touch the global forwarding or LAN routes; saved bridging, services and NAT wait for a per-boot peer confirm (per-peer opt-out: Apply at boot without confirmation).
- Settings and tbn tab Apply now save before applying (OpenFabric No sticks); OpenFabric uses the Fabric Routing reload hook when installed. The beacon accepts no request bodies.

###2026.09.28aa–ac
- Thunderbolt panels (GET) only read cache. Own Dashboard tile; stock Dashboard files no longer edited. Config includes POST-only. Mesh refresh polls on POST only. Bridge names escaped.

###2026.09.27aa
- Plugin payload is a flash .txz from the GitHub Release (not re-fetched from main at boot).

###2026.09.13aa
- DHCP stop pkill quotes the conf name.

###2026.09.09aa–ac
- USB4STREAM Stream tab (create/copy, lab extra/ module, live ConfigFS root).

###2026.09.08aa–ac
- Forget selected (csrf); mesh beacon Thunderbolt IPs; overlay install.


### Older releases
- Full changelog: https://github.com/ibigsnet/ThunderboltNet/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: preparing..."
# Note: do not delete /tmp/plugins/thunderboltnet.plg here — Unraid install working copy
mkdir -p /boot/config/plugins/ThunderboltNet
rm -rf /usr/local/emhttp/plugins/thunderboltnet \
       /usr/local/emhttp/plugins/Thunderboltnet 2>/dev/null || true
echo "ThunderboltNet: ready."
]]></INLINE>
</FILE>

<!-- raw-files begin -->
<FILE Name="&configdir;/ThunderboltNet-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ibigsnet/ThunderboltNet/releases/download/v&version;/ThunderboltNet-&version;-x86_64-1.txz</URL>
<SHA256>7bbebb9deab667f0f9bed676430633ef9d007d795b54bc2bfbd617c251c12cb4</SHA256>
<MD5>7f58e0b10b3c9e90d18629cba3c4c50f</MD5>
</FILE>
<!-- raw-files end -->

<FILE Run="/bin/bash">
<INLINE>find &configdir; -maxdepth 1 -name "&name;-*-x86_64-1.txz" ! -name "&name;-&version;-x86_64-1.txz" -delete 2>/dev/null || true</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: finishing install..."
if [ ! -f /usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php ]; then
  echo "ThunderboltNet: ERROR — package did not install (missing tbn-lib.php)"
  exit 1
fi
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/event/* 2>/dev/null || true
mkdir -p /boot/config/plugins/ThunderboltNet
if [ -f /usr/local/emhttp/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt ]; then
  cp -a /usr/local/emhttp/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt \
    /boot/config/plugins/ThunderboltNet/ThunderboltNet-RECOVERY.txt
fi
# Global cfg from the built-in defaults table (first install), legacy keys dropped,
# old flash mesh cache and NAT sysctl files removed, link-check cron synced.
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-mesh.php"; tbn_write_global_cfg(tbn_load_cfg()); tbn_mesh_cleanup_flash_legacy(); tbn_nat_cleanup_legacy_sysctl(); if (function_exists("tbn_of_apply")) { tbn_of_apply(); }' 2>/dev/null || true
# Update within the same boot (RAM marker or udev rule already present): peers linked right now keep running
# as before (confirmed for this boot). At boot the marker is absent, so nothing is confirmed.
# Hotplug + boot reapply for thunderbolt* L3 (forum persistence findings)
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; $mk = tbn_runtime_path("installed-this-boot"); if (is_file($mk) || is_file("/etc/udev/rules.d/99-thunderboltnet-net.rules")) { $pm = tbn_load_peers_memory(); foreach (tbn_link_summaries() as $L) { tbn_peer_confirm(tbn_peer_key_from_link($L, $pm)); } } @touch($mk); if (function_exists("tbn_migrate_seed_dot2_to_dot1")) { tbn_migrate_seed_dot2_to_dot1(); } tbn_install_net_udev(); if (function_exists("tbn_sync_iface_pages")) { tbn_sync_iface_pages(); }' 2>/dev/null || true
/bin/bash /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-net-reapply >/dev/null 2>&1 || true
udevadm trigger --subsystem-match=net --action=add 2>/dev/null || true
# Older versions patched stock Dashboard files; put them back once.
if [ -x /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-restore ]; then
  /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-restore restore >/dev/null 2>&1 || true
fi
echo "ThunderboltNet: packages now: $(ls /var/log/packages/ThunderboltNet-* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
# update_cron only reads registered plugins; this one registers after the script.
[ -x /usr/local/sbin/update_cron ] && { echo /usr/local/sbin/update_cron | at -M now + 1 minute >/dev/null 2>&1 || true; }
echo "ThunderboltNet: install complete. Settings → Network Settings → Thunderbolt"
echo "ThunderboltNet: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "ThunderboltNet: removing..."
# Undo live changes first (needs the plugin files): beacon, NAT + forwarding,
# OpenFabric fragment / lo /32, DHCP servers, network-extra.cfg entries, cron.
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; foreach (tbn_uninstall_runtime() as $l) { echo "ThunderboltNet: $l\n"; }' 2>/dev/null || true
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; tbn_remove_net_udev();' 2>/dev/null || true
rm -f /etc/udev/rules.d/99-thunderboltnet-net.rules 2>/dev/null || true
udevadm control --reload-rules 2>/dev/null || true
pkill -f 'tbn-mesh-beacon-server\.php' 2>/dev/null || true
pkill -f 'dnsmasq --conf-file=/boot/config/plugins/ThunderboltNet/' 2>/dev/null || true
for conf in /etc/modprobe.d/thunderbolt_net.conf /boot/config/modprobe.d/thunderbolt_net.conf; do
  if [ -f "$conf" ] && grep -q 'thunderbolt_net' "$conf" 2>/dev/null; then
    rm -f "$conf"
  fi
done
if [ -d /boot/config/modprobe.d ] && [ -z "$(ls -A /boot/config/modprobe.d 2>/dev/null)" ]; then
  rmdir /boot/config/modprobe.d 2>/dev/null || true
fi
if [ -x /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-restore ]; then
  /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-restore restore || true
fi
# Package + emhttp
for p in /var/log/packages/ThunderboltNet-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /usr/local/emhttp/plugins/ThunderboltNet
# Flash config + runtime scratch (full uninstall — reinstall starts clean)
rm -rf /boot/config/plugins/ThunderboltNet
rm -f /boot/config/plugins/thunderboltnet/thunderboltnet.cron
rmdir /boot/config/plugins/thunderboltnet 2>/dev/null || true
[ -x /usr/local/sbin/update_cron ] && /usr/local/sbin/update_cron >/dev/null 2>&1
rm -rf /var/local/thunderboltnet /var/lib/thunderboltnet /var/run/thunderboltnet-mesh-beacon 2>/dev/null || true
rm -f /var/run/thunderboltnet.lock /var/run/thunderboltnet-mesh-rl.json /var/run/thunderboltnet-mesh-cron.lock \
      /var/run/tbn-stream-reapply.lock /var/log/thunderboltnet-mesh-beacon.log 2>/dev/null || true
rm -rf /var/tmp/tbn-mesh-rl-* /var/tmp/tbn-stats-* /tmp/tbn-uninstall-keep-* 2>/dev/null || true
rm -f /tmp/plugins/thunderboltnet.txt 2>/dev/null || true
# Note: do not delete /tmp/plugins/thunderboltnet.plg here — Unraid install working copy
# Note: do not touch /boot/config/plugins-removed/ (Unraid-owned)
echo "ThunderboltNet: removed."
]]></INLINE>
</FILE>

</PLUGIN>
