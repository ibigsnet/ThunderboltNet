<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "ThunderboltNet: finishing install..."
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-status 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-openfabric 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/ThunderboltNet/event/started 2>/dev/null || true
mkdir -p /boot/config/plugins/ThunderboltNet/ifaces
mkdir -p /boot/config/plugins/ThunderboltNet/frr
if [ ! -f /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg ]; then
  if [ -f /usr/local/emhttp/plugins/ThunderboltNet/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/ThunderboltNet/default.cfg /boot/config/plugins/ThunderboltNet/ThunderboltNet.cfg
    echo "ThunderboltNet: created default ThunderboltNet.cfg"
  fi
fi
# Generate tbnN tabs for any live thunderbolt* ifaces
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; tbn_sync_iface_pages();' 2>/dev/null || true
# OpenFabric conf preview (no-op if FRR missing)
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; if (function_exists("tbn_of_apply")) { tbn_of_apply(); }' 2>/dev/null || true
# Dashboard Interface list: thunderboltN / bond-tbN / br-tbN (throughput + errors)
if [ -x /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports ]; then
  /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports apply || true
fi
echo "ThunderboltNet: install complete."
echo "ThunderboltNet: Configure → Settings → Network Settings → Thunderbolt"
echo "ThunderboltNet: Per-link IPs → Thunderbolt tbn0 / tbn1 tabs when a peer is online."
echo "ThunderboltNet: CA Actions→Settings opens the Thunderbolt overview alone;"
echo "ThunderboltNet:   use Network Settings for the full eth0 / Thunderbolt / tbn strip."
echo "ThunderboltNet: Optional multi-hop → install UnraidFRR (Network Settings → Fabric Routing) — not USB4STREAM."
echo "ThunderboltNet: Hard-refresh the browser (Ctrl+Shift+R)."
# One-time green notification (first install only; -x single ticket)
MARKER=/boot/config/plugins/ThunderboltNet/first_run_notified
if [ ! -f "$MARKER" ] && [ -x /usr/local/emhttp/webGui/scripts/notify ]; then
  /usr/local/emhttp/webGui/scripts/notify \
    -e "Thunderbolt Net installed" \
    -s "Thunderbolt Net ready" \
    -d "Configure under Network Settings → Thunderbolt (tbn tabs for IPs)." \
    -i "normal" \
    -m "CA Settings opens the Thunderbolt overview. For eth0 + tbn tabs together: Settings → Network Settings. Optional multi-hop: UnraidFRR (Network Settings → Fabric Routing) — routing packages, not thunderbolt_stream/USB4STREAM. Optional disk imaging: Network Services → NBD." \
    -l "/Settings/ThunderboltNet" \
    -x 2>/dev/null || true
  touch "$MARKER" 2>/dev/null || true
  echo "ThunderboltNet: first-run notification posted (once)."
fi
ls -la /usr/local/emhttp/plugins/ThunderboltNet/ || true
ls -la /usr/local/emhttp/plugins/ThunderboltNet/Tbn*.page 2>/dev/null || true
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "ThunderboltNet: removing plugin (full cleanup)..."

EXTRA=/boot/config/network-extra.cfg
if [ -f "$EXTRA" ]; then
  INC=$(sed -n 's/^include_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  EXC=$(sed -n 's/^exclude_interfaces="\(.*\)"/\1/p' "$EXTRA" | head -1)
  NEW=""
  for if in $INC; do
    case "$if" in
      thunderbolt*|bond-tb|bond-tb*|br-tb)
        echo "ThunderboltNet: dropping $if from include_interfaces"
        ;;
      *)
        NEW="${NEW}${NEW:+ }$if"
        ;;
    esac
  done
  {
    echo "include_interfaces=\"${NEW}\""
    echo "exclude_interfaces=\"${EXC}\""
  } > "$EXTRA"
fi

for conf in \
  /etc/modprobe.d/thunderbolt_net.conf \
  /boot/config/modprobe.d/thunderbolt_net.conf
do
  if [ -f "$conf" ] && grep -q 'thunderbolt_net' "$conf" 2>/dev/null; then
    rm -f "$conf"
    echo "ThunderboltNet: removed $conf"
  fi
done
if [ -d /boot/config/modprobe.d ] && [ -z "$(ls -A /boot/config/modprobe.d 2>/dev/null)" ]; then
  rmdir /boot/config/modprobe.d 2>/dev/null || true
fi

# Restore stock Dashboard port lists before removing scripts
if [ -x /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports ]; then
  /usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports remove || true
fi

rm -rf /usr/local/emhttp/plugins/ThunderboltNet
rm -rf /usr/local/emhttp/plugins/thunderboltnet
rm -rf /usr/local/emhttp/plugins/Thunderboltnet
rm -f /usr/local/emhttp/webGui/Thunderbolt*.page /usr/local/emhttp/webGui/Tbn*.page 2>/dev/null || true
rm -f /usr/local/emhttp/plugins/dynamix/Thunderbolt*.page /usr/local/emhttp/plugins/dynamix/Tbn*.page 2>/dev/null || true

# Flash: wipe plugin tree but KEEP known peers + per-tbn iface settings (reinstall-safe)
CFG=/boot/config/plugins/ThunderboltNet
KEEP=/tmp/tbn-uninstall-keep-$$
mkdir -p "$KEEP/ifaces"
if [ -f "$CFG/peers.json" ]; then
  cp -a "$CFG/peers.json" "$KEEP/peers.json" 2>/dev/null || true
fi
if [ -d "$CFG/ifaces" ]; then
  cp -a "$CFG/ifaces/." "$KEEP/ifaces/" 2>/dev/null || true
fi
rm -rf /boot/config/plugins/ThunderboltNet
rm -rf /boot/config/plugins/thunderboltnet
rm -rf /boot/config/plugins/Thunderboltnet
mkdir -p /boot/config/plugins/ThunderboltNet/ifaces
if [ -f "$KEEP/peers.json" ]; then
  cp -a "$KEEP/peers.json" /boot/config/plugins/ThunderboltNet/peers.json
  echo "ThunderboltNet: kept known peers (peers.json)"
fi
if [ -d "$KEEP/ifaces" ] && [ -n "$(ls -A "$KEEP/ifaces" 2>/dev/null)" ]; then
  cp -a "$KEEP/ifaces/." /boot/config/plugins/ThunderboltNet/ifaces/
  echo "ThunderboltNet: kept per-iface settings (ifaces/)"
fi
rm -rf "$KEEP"

rm -f /tmp/plugins/thunderboltnet.plg /tmp/plugins/thunderboltnet.txt 2>/dev/null || true
rm -f /tmp/plugins/ThunderboltNet* /tmp/inline*-thunderboltnet.sh 2>/dev/null || true

if [ -e /usr/local/emhttp/plugins/ThunderboltNet ] || [ -e /usr/local/emhttp/plugins/thunderboltnet ]; then
  echo "ThunderboltNet: WARNING — emhttp plugin path still present"
else
  echo "ThunderboltNet: emhttp plugin paths clear"
fi
echo "ThunderboltNet: removed (peers + iface settings preserved on flash)."
]]></INLINE>
</FILE>

</PLUGIN>
