#!/bin/bash
# Unraid plugin event: started
# Runs when the array has started (Normal or Maintenance mode).
# Not the same as "Unraid OS is up" — see event/startup for early udev/L3.
#
# Job: Dashboard TB ports, OpenFabric, and a second reapply (peer may
# appear after array start; udev may need a refresh after full boot).

SCRIPT=/usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-dashboard-ports
if [ -x "$SCRIPT" ]; then
  # Quiet stdout: Unraid merges event stdout into "Array Started • …" footer.
  # ensure = heal if already patched; apply only when TB hardware/netdev present.
  "$SCRIPT" ensure >/dev/null || true
fi

# OpenFabric: regenerate conf + best-effort FRR reload (no-op if FRR missing)
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; if (function_exists("tbn_of_apply")) { tbn_of_apply(); }' 2>/dev/null || true

# Re-assert e2e + udev (RAM root) + L3 after array start
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; tbn_ensure_e2e_param(); tbn_install_net_udev();' 2>/dev/null || true

REAPPLY=/usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-net-reapply
if [ -f "$REAPPLY" ]; then
  /bin/bash "$REAPPLY" >/dev/null 2>&1 || true
fi

udevadm trigger --subsystem-match=net --action=add 2>/dev/null || true

# Peer link-check beacon (php -S :10807) — bypasses Unraid login 302 on /plugins export
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; $m="/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-mesh.php"; if (is_file($m)) { require_once $m; if (function_exists("tbn_mesh_beacon_ensure")) { tbn_mesh_beacon_ensure(); } }' 2>/dev/null || true

exit 0
