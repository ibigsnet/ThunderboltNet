#!/bin/bash
# Unraid plugin event: startup
# Runs after plugins install at system boot — independent of array state.
# (Array may be stopped, never started yet, or later started in Maintenance.)
#
# Job: restore RAM udev rule + re-apply TB L3 so host-net works before
# array Online (management over Thunderbolt, early peer link, etc.).
# Heavier work (Dashboard port patch, OpenFabric) waits for event/started.

logger -t ThunderboltNet "event/startup: e2e modprobe + udev + reapply L3"

# Persist e2e to flash+ram and reload thunderbolt_net if kernel defaulted e2e=1
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php";
$r = tbn_ensure_e2e_param();
if (!empty($r["reloaded"])) { fwrite(STDERR, "ThunderboltNet: reloaded thunderbolt_net e2e=" . ($r["e2e"] ?? "?") . "\n"); }
tbn_install_net_udev();
if (function_exists("tbn_sync_iface_pages")) { tbn_sync_iface_pages(); }
' 2>/dev/null || true

REAPPLY=/usr/local/emhttp/plugins/ThunderboltNet/scripts/tbn-net-reapply
if [ -f "$REAPPLY" ]; then
  /bin/bash "$REAPPLY" >/dev/null 2>&1 || true
fi

# Netdevs that appeared before the rule was restored
udevadm trigger --subsystem-match=net --action=add 2>/dev/null || true

# Mesh beacon early if link-check enabled (array may still be stopped)
php -r 'require_once "/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-lib.php"; $m="/usr/local/emhttp/plugins/ThunderboltNet/include/tbn-mesh.php"; if (is_file($m)) { require_once $m; if (function_exists("tbn_mesh_beacon_ensure")) { tbn_mesh_beacon_ensure(); } }' 2>/dev/null || true

exit 0
